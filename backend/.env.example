# ====================================================================
# Antojo24 Backend (Python / Flask) - Variables de Entorno
# ====================================================================

# 1. Base de Datos PostgreSQL (OBLIGATORIA)
# URL de conexión a la base de datos PostgreSQL (Railway, Supabase o local).
# Si falta, la aplicación arrojará RuntimeError: DATABASE_PUBLIC_URL environment variable not set
DATABASE_PUBLIC_URL=postgresql://postgres:password@localhost:5432/antojo24

# 2. Configuración del Servidor
PORT=5000

# 3. URLs de Frontend permitidas para CORS
FRONTEND_URL=http://localhost:5173
NETLIFY_URL=https://antojo24.netlify.app

# 4. Integraciones (Opcionales)
N8N_API_KEY=tu-api-key-de-n8n
N8N_WEBHOOK_URL=https://tu-n8n-url.com
